      "name": "Webhook de reportes",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        120
      ],
      "webhookId": "0cb7e14f-d2be-4928-9d84-1a35c0aafc33"
